---
// Shared modal shell. Shown when the root Alpine `modal` state equals `name`;
// the backdrop, Escape handling and focus management live in index.astro.
interface Props {
    name: string;
    width?: string;
    eyebrow?: string;
    heading?: string;
    label?: string; // accessible name when there is no visible heading
}
const { name, width = "md:max-w-xl", eyebrow, heading, label } = Astro.props;
const headingId = `modal-${name}-title`;
---

<div
    x-show={`modal === '${name}'`}
    data-modal={name}
    role="dialog"
    aria-modal="true"
    aria-labelledby={heading ? headingId : undefined}
    aria-label={heading ? undefined : (label ?? eyebrow ?? name)}
    @keydown.tab="trapFocus($event, $el)"
    class:list={[
        "relative bg-(--card-bg) border border-(--card-border) rounded-2xl w-full max-w-sm my-auto",
        width,
    ]}
>
    <button
        type="button"
        data-close
        aria-label="Close"
        @click="modal = null"
        class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-(--inner-bg) border border-(--dim-border) text-(--muted) hover:text-(--heading) flex items-center justify-center text-xl leading-none transition-colors cursor-pointer"
        ><span aria-hidden="true">&times;</span></button
    >
    <div class="p-6 md:p-8">
        {eyebrow && (
            <p class="eyebrow text-[11px] mb-1.5">
                {eyebrow}
            </p>
        )}
        {heading && (
            <h2 id={headingId} class="text-2xl md:text-[1.75rem] font-semibold leading-tight mb-6">
                {heading}
            </h2>
        )}
        <slot />
    </div>
</div>
