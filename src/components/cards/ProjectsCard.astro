<div
    class="bento-card clickable col-span-1 lg:min-h-0 lg:flex-[1.5] py-8 lg:py-0 flex flex-col items-center justify-center overflow-hidden"
    style="background: linear-gradient(135deg, var(--card-bg), color-mix(in srgb, var(--accent) 15%, var(--card-bg)))"
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    aria-label="Open projects"
    @click="modal = 'projects'"
    @keydown.enter.self="modal = 'projects'"
    @keydown.space.self.prevent="modal = 'projects'"
>
    <p
        class="font-display italic font-medium text-(--accent) text-4xl lg:text-[clamp(1.5rem,11cqw,2.4rem)] leading-none whitespace-nowrap tracking-[-0.01em]"
        style="font-variation-settings: 'SOFT' 100, 'WONK' 1"
    >
        Projects
    </p>
</div>
