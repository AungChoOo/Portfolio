---
// No props — data fetched client-side
---

<div class="bento-card col-span-1 lg:min-h-0 p-4 lg:p-[clamp(0.75rem,3cqw,1.25rem)] flex flex-col justify-between gap-2 lg:gap-[clamp(0.25rem,2cqw,0.75rem)] overflow-hidden lg:flex-1">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
        <h2 class="card-heading text-base lg:text-[clamp(0.8rem,1.2vw,1.1rem)] whitespace-nowrap">
            Where I am
        </h2>
        <p id="bkk-date" class="text-sm lg:text-[clamp(0.65rem,0.95vw,0.85rem)] text-(--muted) font-medium whitespace-nowrap">---</p>
    </div>

    <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
        <p class="text-base lg:text-[clamp(0.85rem,1.4vw,1.15rem)] text-(--heading) font-display font-semibold whitespace-nowrap">Bangkok, TH</p>
        <p
            id="bkk-time"
            class="text-xl lg:text-[clamp(0.95rem,1.8vw,1.5rem)] font-semibold text-(--heading) tabular-nums leading-none whitespace-nowrap"
        >
            --:--:--
        </p>
    </div>
</div>

<script>
    function updateClock() {
        const now = new Date();
        const el = (id: string) => document.getElementById(id)!;
        el("bkk-time").textContent = now.toLocaleTimeString("en-US", {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
            timeZone: "Asia/Bangkok",
        });
        el("bkk-date").textContent = now.toLocaleDateString("en-US", {
            weekday: "short",
            month: "short",
            day: "numeric",
            timeZone: "Asia/Bangkok",
        });
    }

    updateClock();
    setInterval(updateClock, 1000);
</script>
